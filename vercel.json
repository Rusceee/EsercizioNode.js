{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": "backend/gateway",
      "entrypoint": "src/gateway.js",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "SERVICE_URL"
        },
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "AUTH_SERVICE_URL"
        }
      ]
    },
    "auth": {
      "root": "backend/auth-service",
      "entrypoint": "src/authserver.js"
    },
    "api": {
      "root": "backend/service",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "gateway"
      }
    }
  ]
}